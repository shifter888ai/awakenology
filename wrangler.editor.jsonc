{
  "name": "awakenology-editor-staging",
  "main": "./editor-worker.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-editor/",
    "binding": "ASSETS",
    "base_path": "/editor",
    "run_worker_first": true,
    "not_found_handling": "none"
  }
}
